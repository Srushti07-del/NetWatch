# NetWatch frontend environment variables
# Copy this file to .env and adjust values as needed.
# Only variables prefixed with VITE_ are exposed to the frontend code.

# Base URL for the FastAPI backend API.
# Leave empty when running in demo mode (no backend required).
VITE_API_BASE_URL=

# Enable or disable demo mode.
# "true"  -> uses local mock data, no HTTP requests (default)
# "false" -> uses real HTTP requests to VITE_API_BASE_URL
VITE_DEMO_MODE=true
